{
  "duration_sec": 305.496,
  "words": [
    {
      "type": "SentenceBoundary",
      "text": "คืนก่อนวันคริสต์มาส",
      "offset_sec": 0.1,
      "duration_sec": 2.3931819
    },
    {
      "type": "SentenceBoundary",
      "text": "ในห้องเช่าเล็กๆของนิวยอร์ก",
      "offset_sec": 2.4431819,
      "duration_sec": 2.6136365
    },
    {
      "type": "SentenceBoundary",
      "text": "มีหญิงสาวคนหนึ่งนับเงินอยู่ในมือ",
      "offset_sec": 5.0568185,
      "duration_sec": 3.1250002
    },
    {
      "type": "SentenceBoundary",
      "text": "เธอมีไม่มากนักและกำลังจะทำอะไรบางอย่าง",
      "offset_sec": 8.1818187,
      "duration_sec": 3.7500002
    },
    {
      "type": "SentenceBoundary",
      "text": "ที่คนทั้งโลกเรียกมันว่าความรัก",
      "offset_sec": 11.931819,
      "duration_sec": 2.8693183
    },
    {
      "type": "SentenceBoundary",
      "text": "หนึ่งดอลลาร์กับอีกแปดสิบเจ็ดเซนต์",
      "offset_sec": 14.8011374,
      "duration_sec": 3.0539774
    },
    {
      "type": "SentenceBoundary",
      "text": "นั่นคือทั้งหมดที่เดลลามี",
      "offset_sec": 17.8551149,
      "duration_sec": 2.6562501
    },
    {
      "type": "SentenceBoundary",
      "text": "เธอนับมันสามรอบ",
      "offset_sec": 20.5113651,
      "duration_sec": 2.3011365
    },
    {
      "type": "SentenceBoundary",
      "text": "นับแล้วนับอีกหนึ่งดอลลาร์แปดสิบเจ็ดเซนต์",
      "offset_sec": 22.8125016,
      "duration_sec": 3.5653411
    },
    {
      "type": "SentenceBoundary",
      "text": "และพรุ่งนี้คือวันคริสต์มาส",
      "offset_sec": 26.3778428,
      "duration_sec": 2.7130683
    },
    {
      "type": "SentenceBoundary",
      "text": "ห้องเช่าแคบๆแปดดอลลาร์ต่อสัปดาห์",
      "offset_sec": 29.0909112,
      "duration_sec": 3.4659093
    },
    {
      "type": "SentenceBoundary",
      "text": "กล่องจดหมายที่ไม่มีจดหมายส่งมาถึง",
      "offset_sec": 32.5568205,
      "duration_sec": 3.4801138
    },
    {
      "type": "SentenceBoundary",
      "text": "ป้ายชื่อที่เขียนว่าเจมส์ดิลลิงแฮมยัง",
      "offset_sec": 36.0369344,
      "duration_sec": 3.2954547
    },
    {
      "type": "SentenceBoundary",
      "text": "ชื่อยาวๆที่เหลือจากวันที่เขายังมีงานดีๆ",
      "offset_sec": 39.3323892,
      "duration_sec": 3.7500002
    },
    {
      "type": "SentenceBoundary",
      "text": "แต่ตอนนี้รายได้ของจิมลดลงครึ่งหนึ่ง",
      "offset_sec": 43.0823895,
      "duration_sec": 3.3096593
    },
    {
      "type": "SentenceBoundary",
      "text": "และชื่อยาวๆนั้นก็ไม่สำคัญอีกแล้ว",
      "offset_sec": 46.3920488,
      "duration_sec": 3.5085229
    },
    {
      "type": "SentenceBoundary",
      "text": "เดลลาทรุดตัวลงบนโซฟาเก่าๆ",
      "offset_sec": 49.9005718,
      "duration_sec": 3.1250002
    },
    {
      "type": "SentenceBoundary",
      "text": "แล้วร้องไห้",
      "offset_sec": 53.025572,
      "duration_sec": 1.8323864
    },
    {
      "type": "SentenceBoundary",
      "text": "เธออยากซื้อของขวัญให้จิม",
      "offset_sec": 54.8579585,
      "duration_sec": 2.6420456
    },
    {
      "type": "SentenceBoundary",
      "text": "สามีของเธอผู้ชายที่เธอรักที่สุดในโลก",
      "offset_sec": 57.5000042,
      "duration_sec": 3.5511366
    },
    {
      "type": "SentenceBoundary",
      "text": "แต่เธอมีเงินแค่หนึ่งดอลลาร์แปดสิบเจ็ดเซนต์",
      "offset_sec": 61.0511408,
      "duration_sec": 3.6363639
    },
    {
      "type": "SentenceBoundary",
      "text": "จะซื้ออะไรให้เขาได้",
      "offset_sec": 64.6875047,
      "duration_sec": 2.3721592
    },
    {
      "type": "SentenceBoundary",
      "text": "เดลลาเดินไปหน้ากระจก",
      "offset_sec": 67.0596639,
      "duration_sec": 2.3295456
    },
    {
      "type": "SentenceBoundary",
      "text": "ปลดผมของเธอลง",
      "offset_sec": 69.3892096,
      "duration_sec": 2.2301137
    },
    {
      "type": "SentenceBoundary",
      "text": "ผมของเดลลายาวสวยเป็นมรดกที่เธอภาคภูมิใจที่สุด",
      "offset_sec": 71.6193234,
      "duration_sec": 4.758523
    },
    {
      "type": "SentenceBoundary",
      "text": "มันยาวเลยเข่าลงมาเงางามเหมือนน้ำไหล",
      "offset_sec": 76.3778464,
      "duration_sec": 3.4090911
    },
    {
      "type": "SentenceBoundary",
      "text": "เมื่อเธอปล่อยลงมันก็คลี่เป็นผ้าคลุมสีน้ำตาลทั้งตัว",
      "offset_sec": 79.7869376,
      "duration_sec": 4.0909093
    },
    {
      "type": "SentenceBoundary",
      "text": "แล้วความคิดหนึ่งก็ผุดขึ้นในหัวของเธอ",
      "offset_sec": 83.877847,
      "duration_sec": 3.4517047
    },
    {
      "type": "SentenceBoundary",
      "text": "เดลลาออกจากบ้าน",
      "offset_sec": 87.3295518,
      "duration_sec": 2.2443183
    },
    {
      "type": "SentenceBoundary",
      "text": "เดินไปตามถนนที่หนาวเหน็บ",
      "offset_sec": 89.5738701,
      "duration_sec": 2.5284092
    },
    {
      "type": "SentenceBoundary",
      "text": "และเข้าไปในร้านทำผม",
      "offset_sec": 92.1022794,
      "duration_sec": 2.6704547
    },
    {
      "type": "SentenceBoundary",
      "text": "ขายผมไหม",
      "offset_sec": 94.7727342,
      "duration_sec": 1.9460228
    },
    {
      "type": "SentenceBoundary",
      "text": "เธอถาม",
      "offset_sec": 96.718757,
      "duration_sec": 1.6761364
    },
    {
      "type": "SentenceBoundary",
      "text": "ผู้หญิงผมแดงที่ทำร้านวางมือลง",
      "offset_sec": 98.3948935,
      "duration_sec": 3.2102275
    },
    {
      "type": "SentenceBoundary",
      "text": "มองผมของเดลลาด้วยสายตาของคนค้าขาย",
      "offset_sec": 101.605121,
      "duration_sec": 3.8068184
    },
    {
      "type": "SentenceBoundary",
      "text": "ยี่สิบดอลลาร์",
      "offset_sec": 105.4119395,
      "duration_sec": 1.9176137
    },
    {
      "type": "SentenceBoundary",
      "text": "เท่านั้นเองหรือ",
      "offset_sec": 107.3295533,
      "duration_sec": 2.1164774
    },
    {
      "type": "SentenceBoundary",
      "text": "ยี่สิบดอลลาร์",
      "offset_sec": 109.4460307,
      "duration_sec": 1.9176137
    },
    {
      "type": "SentenceBoundary",
      "text": "เดลลาหลับตาแล้วพยักหน้า",
      "offset_sec": 111.3636445,
      "duration_sec": 2.7414774
    },
    {
      "type": "SentenceBoundary",
      "text": "กรรไกรดังขึ้น",
      "offset_sec": 114.1051219,
      "duration_sec": 2.0596592
    },
    {
      "type": "SentenceBoundary",
      "text": "ปอยผมสีน้ำตาลตกลงพื้นทีละปอย",
      "offset_sec": 116.1647812,
      "duration_sec": 3.4090911
    },
    {
      "type": "SentenceBoundary",
      "text": "ทีละปอย",
      "offset_sec": 119.5738723,
      "duration_sec": 1.7613637
    },
    {
      "type": "SentenceBoundary",
      "text": "หนึ่งชั่วโมงต่อมา",
      "offset_sec": 121.3352361,
      "duration_sec": 2.1875001
    },
    {
      "type": "SentenceBoundary",
      "text": "เดลลากลับบ้านผมสั้นแค่ติ่งหู",
      "offset_sec": 123.5227363,
      "duration_sec": 3.1960229
    },
    {
      "type": "SentenceBoundary",
      "text": "แต่ในมือเธอมีเงินยี่สิบดอลลาร์",
      "offset_sec": 126.7187592,
      "duration_sec": 2.911932
    },
    {
      "type": "SentenceBoundary",
      "text": "เธอใช้เวลาสองชั่วโมงเดินหาร้านแล้วหาร้านอีก",
      "offset_sec": 129.6306913,
      "duration_sec": 3.977273
    },
    {
      "type": "SentenceBoundary",
      "text": "เลือกของขวัญให้จิม",
      "offset_sec": 133.6079643,
      "duration_sec": 2.2443183
    },
    {
      "type": "SentenceBoundary",
      "text": "และเธอก็พบมัน",
      "offset_sec": 135.8522826,
      "duration_sec": 2.1875001
    },
    {
      "type": "SentenceBoundary",
      "text": "สายนาฬิกาแพลทินัม",
      "offset_sec": 138.0397828,
      "duration_sec": 2.4573865
    },
    {
      "type": "SentenceBoundary",
      "text": "เรียบเงางามไม่มีลวดลายเกินจำเป็น",
      "offset_sec": 140.4971693,
      "duration_sec": 3.4375002
    },
    {
      "type": "SentenceBoundary",
      "text": "คู่ควรกับนาฬิกาทองคำของจิม",
      "offset_sec": 143.9346696,
      "duration_sec": 3.1960229
    },
    {
      "type": "SentenceBoundary",
      "text": "นาฬิกาเรือนนั้นเป็นมรดกจากพ่อของเขา",
      "offset_sec": 147.316,
      "duration_sec": 3.7426139
    },
    {
      "type": "SentenceBoundary",
      "text": "เป็นสิ่งที่มีค่าที่สุดที่จิมมี",
      "offset_sec": 151.0086139,
      "duration_sec": 3.0539774
    },
    {
      "type": "SentenceBoundary",
      "text": "เป็นสิ่งเดียวที่เขาไม่เคยยอมปล่อย",
      "offset_sec": 154.0625914,
      "duration_sec": 3.068182
    },
    {
      "type": "SentenceBoundary",
      "text": "เดลลาจ่ายเงินยี่สิบดอลลาร์",
      "offset_sec": 157.1307734,
      "duration_sec": 2.8125002
    },
    {
      "type": "SentenceBoundary",
      "text": "แล้วรีบกลับบ้านด้วยความดีใจ",
      "offset_sec": 159.9432736,
      "duration_sec": 2.8977274
    },
    {
      "type": "SentenceBoundary",
      "text": "ถึงบ้านเธอต้มน้ำกินข้าว",
      "offset_sec": 162.8410011,
      "duration_sec": 2.8267047
    },
    {
      "type": "SentenceBoundary",
      "text": "แล้วนั่งรอจิมกลับมา",
      "offset_sec": 165.6677058,
      "duration_sec": 2.5710229
    },
    {
      "type": "SentenceBoundary",
      "text": "หกโมงเย็นประตูเปิด",
      "offset_sec": 168.2387288,
      "duration_sec": 2.2869319
    },
    {
      "type": "SentenceBoundary",
      "text": "จิมก้าวเข้ามาแล้วหยุดชะงัก",
      "offset_sec": 170.5256607,
      "duration_sec": 2.5568183
    },
    {
      "type": "SentenceBoundary",
      "text": "เขาจ้องมองเดลลา",
      "offset_sec": 173.0824791,
      "duration_sec": 2.1732956
    },
    {
      "type": "SentenceBoundary",
      "text": "สายตาของเขาแปลกไป",
      "offset_sec": 175.2557747,
      "duration_sec": 2.5426138
    },
    {
      "type": "SentenceBoundary",
      "text": "ไม่ใช่โกรธไม่ใช่ผิดหวัง",
      "offset_sec": 177.7983886,
      "duration_sec": 2.6278411
    },
    {
      "type": "SentenceBoundary",
      "text": "แต่เป็นสายตาของคนที่เพิ่งเห็นอะไรบางอย่าง",
      "offset_sec": 180.4262297,
      "duration_sec": 3.5653411
    },
    {
      "type": "SentenceBoundary",
      "text": "เดลลาลุกขึ้นเดินไปหาเขา",
      "offset_sec": 183.9915708,
      "duration_sec": 2.8267047
    },
    {
      "type": "SentenceBoundary",
      "text": "จิมอย่ามองฉันแบบนั้น",
      "offset_sec": 186.8182756,
      "duration_sec": 2.5568183
    },
    {
      "type": "SentenceBoundary",
      "text": "ฉันตัดผมขายเพราะอยากได้ของขวัญให้เธอ",
      "offset_sec": 189.3750939,
      "duration_sec": 3.5937502
    },
    {
      "type": "SentenceBoundary",
      "text": "ผมของฉันมันจะยาวใหม่ก็ได้ไม่เป็นไรนะ",
      "offset_sec": 192.9688442,
      "duration_sec": 3.7784093
    },
    {
      "type": "SentenceBoundary",
      "text": "จิมไม่พูดอะไร",
      "offset_sec": 196.7472536,
      "duration_sec": 2.1022728
    },
    {
      "type": "SentenceBoundary",
      "text": "เขาเดินเข้าไปกอดเธอแน่น",
      "offset_sec": 198.8495265,
      "duration_sec": 2.4857956
    },
    {
      "type": "SentenceBoundary",
      "text": "กอดนานจนเดลลาเริ่มหายใจไม่ออก",
      "offset_sec": 201.3353221,
      "duration_sec": 3.1534093
    },
    {
      "type": "SentenceBoundary",
      "text": "แล้วเขาก็วางห่อของลงบนโต๊ะ",
      "offset_sec": 204.4887314,
      "duration_sec": 2.8551138
    },
    {
      "type": "SentenceBoundary",
      "text": "เดลลาแกะห่อนั้น",
      "offset_sec": 207.3438453,
      "duration_sec": 2.159091
    },
    {
      "type": "SentenceBoundary",
      "text": "มือของเธอสั่น",
      "offset_sec": 209.5029363,
      "duration_sec": 1.9034092
    },
    {
      "type": "SentenceBoundary",
      "text": "ข้างในคือหวี",
      "offset_sec": 211.4063456,
      "duration_sec": 2.002841
    },
    {
      "type": "SentenceBoundary",
      "text": "หวีสองอันที่เธอเคยเห็นในร้าน",
      "offset_sec": 213.4091866,
      "duration_sec": 2.9687502
    },
    {
      "type": "SentenceBoundary",
      "text": "หวีที่เธออยากได้มาตลอด",
      "offset_sec": 216.3779368,
      "duration_sec": 2.5142047
    },
    {
      "type": "SentenceBoundary",
      "text": "หวีที่ทำมาเพื่อผมยาวของเธอโดยเฉพาะ",
      "offset_sec": 218.8921416,
      "duration_sec": 3.4375002
    },
    {
      "type": "SentenceBoundary",
      "text": "หวีที่เธอฝันถึงทุกคืน",
      "offset_sec": 222.3296418,
      "duration_sec": 2.6136365
    },
    {
      "type": "SentenceBoundary",
      "text": "เดลลาน้ำตาไหล",
      "offset_sec": 224.9432784,
      "duration_sec": 2.1306819
    },
    {
      "type": "SentenceBoundary",
      "text": "แล้วเธอก็เงยหน้าขึ้นถาม",
      "offset_sec": 227.0739603,
      "duration_sec": 2.7130683
    },
    {
      "type": "SentenceBoundary",
      "text": "จิมขายนาฬิกาไปแล้วใช่ไหม",
      "offset_sec": 229.7870287,
      "duration_sec": 3.0539774
    },
    {
      "type": "SentenceBoundary",
      "text": "จิมยิ้มแล้วตอบเบาๆ",
      "offset_sec": 232.8410062,
      "duration_sec": 2.4857956
    },
    {
      "type": "SentenceBoundary",
      "text": "ผมขายนาฬิกาไป",
      "offset_sec": 235.3268018,
      "duration_sec": 2.4431819
    },
    {
      "type": "SentenceBoundary",
      "text": "เพื่อซื้อหวีให้เธอ",
      "offset_sec": 237.7699838,
      "duration_sec": 2.1448865
    },
    {
      "type": "SentenceBoundary",
      "text": "เธอตัดผมขายเพื่อซื้อสายนาฬิกาให้ผม",
      "offset_sec": 239.9148704,
      "duration_sec": 3.7215911
    },
    {
      "type": "SentenceBoundary",
      "text": "ทั้งคู่มองหน้ากัน",
      "offset_sec": 243.6364615,
      "duration_sec": 2.2017047
    },
    {
      "type": "SentenceBoundary",
      "text": "แล้วก็หัวเราะออกมา",
      "offset_sec": 245.8381663,
      "duration_sec": 2.3863638
    },
    {
      "type": "SentenceBoundary",
      "text": "ในห้องแคบๆแปดดอลลาร์ต่อสัปดาห์",
      "offset_sec": 248.2245301,
      "duration_sec": 3.3664775
    },
    {
      "type": "SentenceBoundary",
      "text": "ของขวัญสองชิ้นนั้นใช้ไม่ได้จริง",
      "offset_sec": 251.5910076,
      "duration_sec": 3.1676138
    },
    {
      "type": "SentenceBoundary",
      "text": "หวีกับผมที่ไม่มีแล้ว",
      "offset_sec": 254.7586215,
      "duration_sec": 2.4857956
    },
    {
      "type": "SentenceBoundary",
      "text": "สายนาฬิกากับนาฬิกาที่ไม่มีแล้ว",
      "offset_sec": 257.2444171,
      "duration_sec": 3.3664775
    },
    {
      "type": "SentenceBoundary",
      "text": "แต่นั่นแหละ",
      "offset_sec": 260.6108946,
      "duration_sec": 1.5767046
    },
    {
      "type": "SentenceBoundary",
      "text": "ของขวัญที่ดีที่สุด",
      "offset_sec": 262.1875993,
      "duration_sec": 2.1875001
    },
    {
      "type": "SentenceBoundary",
      "text": "ไม่ใช่สิ่งที่ซื้อด้วยเงิน",
      "offset_sec": 264.3750994,
      "duration_sec": 2.5142047
    },
    {
      "type": "SentenceBoundary",
      "text": "แต่คือสิ่งที่เรายอมเสียสละเพื่อคนที่เรารัก",
      "offset_sec": 266.8893042,
      "duration_sec": 3.7357957
    },
    {
      "type": "SentenceBoundary",
      "text": "หนึ่งดอลลาร์แปดสิบเจ็ดเซนต์",
      "offset_sec": 270.6250999,
      "duration_sec": 2.7272729
    },
    {
      "type": "SentenceBoundary",
      "text": "กับหัวใจที่ให้จนหมด",
      "offset_sec": 273.3523728,
      "duration_sec": 2.3437501
    },
    {
      "type": "SentenceBoundary",
      "text": "ของขวัญของคนสองคน",
      "offset_sec": 275.696123,
      "duration_sec": 2.599432
    },
    {
      "type": "SentenceBoundary",
      "text": "ที่ยอมเป็นคนโง่เพื่อให้อีกคนได้ยิ้ม",
      "offset_sec": 278.295555,
      "duration_sec": 3.2670456
    },
    {
      "type": "SentenceBoundary",
      "text": "และนั่นแหละ",
      "offset_sec": 281.5626007,
      "duration_sec": 1.5909092
    },
    {
      "type": "SentenceBoundary",
      "text": "คือของขวัญที่ฉลาดที่สุดในโลก",
      "offset_sec": 283.1535099,
      "duration_sec": 2.8977274
    },
    {
      "type": "SentenceBoundary",
      "text": "ขอบคุณที่ฟังเรื่องราวของเดลลาและจิม",
      "offset_sec": 286.0512374,
      "duration_sec": 3.2812502
    },
    {
      "type": "SentenceBoundary",
      "text": "ถ้าคุณมีใครสักคนที่รัก",
      "offset_sec": 289.3324876,
      "duration_sec": 2.6704547
    },
    {
      "type": "SentenceBoundary",
      "text": "อย่าลืมบอกเขาว่าคุณรักเขา",
      "offset_sec": 292.0029424,
      "duration_sec": 2.9261365
    },
    {
      "type": "SentenceBoundary",
      "text": "และถ้ายังไม่มี",
      "offset_sec": 294.9290789,
      "duration_sec": 2.1306819
    },
    {
      "type": "SentenceBoundary",
      "text": "ขอให้วันหนึ่งคุณได้เจอ",
      "offset_sec": 297.0597609,
      "duration_sec": 2.471591
    },
    {
      "type": "SentenceBoundary",
      "text": "คนที่ยอมเป็นคนโง่เพื่อคุณเหมือนกัน",
      "offset_sec": 299.716,
      "duration_sec": 3.2028411
    }
  ],
  "lines": [
    {
      "text": "คืนก่อนวันคริสต์มาส",
      "start": 0.1
    },
    {
      "text": "ในห้องเช่าเล็กๆของนิวยอร์ก",
      "start": 2.443
    },
    {
      "text": "มีหญิงสาวคนหนึ่งนับเงินอยู่ในมือ",
      "start": 5.057
    },
    {
      "text": "เธอมีไม่มากนักและกำลังจะทำอะไรบางอย่าง",
      "start": 8.182
    },
    {
      "text": "ที่คนทั้งโลกเรียกมันว่าความรัก",
      "start": 11.932
    },
    {
      "text": "หนึ่งดอลลาร์กับอีกแปดสิบเจ็ดเซนต์",
      "start": 14.801
    },
    {
      "text": "นั่นคือทั้งหมดที่เดลลามี",
      "start": 17.855
    },
    {
      "text": "เธอนับมันสามรอบ",
      "start": 20.511
    },
    {
      "text": "นับแล้วนับอีกหนึ่งดอลลาร์แปดสิบเจ็ดเซนต์",
      "start": 22.813
    },
    {
      "text": "และพรุ่งนี้คือวันคริสต์มาส",
      "start": 26.378
    },
    {
      "text": "ห้องเช่าแคบๆแปดดอลลาร์ต่อสัปดาห์",
      "start": 29.091
    },
    {
      "text": "กล่องจดหมายที่ไม่มีจดหมายส่งมาถึง",
      "start": 32.557
    },
    {
      "text": "ป้ายชื่อที่เขียนว่าเจมส์ดิลลิงแฮมยัง",
      "start": 36.037
    },
    {
      "text": "ชื่อยาวๆที่เหลือจากวันที่เขายังมีงานดีๆ",
      "start": 39.332
    },
    {
      "text": "แต่ตอนนี้รายได้ของจิมลดลงครึ่งหนึ่ง",
      "start": 43.082
    },
    {
      "text": "และชื่อยาวๆนั้นก็ไม่สำคัญอีกแล้ว",
      "start": 46.392
    },
    {
      "text": "เดลลาทรุดตัวลงบนโซฟาเก่าๆ",
      "start": 49.901
    },
    {
      "text": "แล้วร้องไห้",
      "start": 53.026
    },
    {
      "text": "เธออยากซื้อของขวัญให้จิม",
      "start": 54.858
    },
    {
      "text": "สามีของเธอผู้ชายที่เธอรักที่สุดในโลก",
      "start": 57.5
    },
    {
      "text": "แต่เธอมีเงินแค่หนึ่งดอลลาร์แปดสิบเจ็ดเซนต์",
      "start": 61.051
    },
    {
      "text": "จะซื้ออะไรให้เขาได้",
      "start": 64.688
    },
    {
      "text": "เดลลาเดินไปหน้ากระจก",
      "start": 67.06
    },
    {
      "text": "ปลดผมของเธอลง",
      "start": 69.389
    },
    {
      "text": "ผมของเดลลายาวสวยเป็นมรดกที่เธอภาคภูมิใจที่สุด",
      "start": 71.619
    },
    {
      "text": "มันยาวเลยเข่าลงมาเงางามเหมือนน้ำไหล",
      "start": 76.378
    },
    {
      "text": "เมื่อเธอปล่อยลงมันก็คลี่เป็นผ้าคลุมสีน้ำตาลทั้งตัว",
      "start": 79.787
    },
    {
      "text": "แล้วความคิดหนึ่งก็ผุดขึ้นในหัวของเธอ",
      "start": 83.878
    },
    {
      "text": "เดลลาออกจากบ้าน",
      "start": 87.33
    },
    {
      "text": "เดินไปตามถนนที่หนาวเหน็บ",
      "start": 89.574
    },
    {
      "text": "และเข้าไปในร้านทำผม",
      "start": 92.102
    },
    {
      "text": "ขายผมไหม",
      "start": 94.773
    },
    {
      "text": "เธอถาม",
      "start": 96.719
    },
    {
      "text": "ผู้หญิงผมแดงที่ทำร้านวางมือลง",
      "start": 98.395
    },
    {
      "text": "มองผมของเดลลาด้วยสายตาของคนค้าขาย",
      "start": 101.605
    },
    {
      "text": "ยี่สิบดอลลาร์",
      "start": 105.412
    },
    {
      "text": "เท่านั้นเองหรือ",
      "start": 107.33
    },
    {
      "text": "ยี่สิบดอลลาร์",
      "start": 109.446
    },
    {
      "text": "เดลลาหลับตาแล้วพยักหน้า",
      "start": 111.364
    },
    {
      "text": "กรรไกรดังขึ้น",
      "start": 114.105
    },
    {
      "text": "ปอยผมสีน้ำตาลตกลงพื้นทีละปอย",
      "start": 116.165
    },
    {
      "text": "ทีละปอย",
      "start": 119.574
    },
    {
      "text": "หนึ่งชั่วโมงต่อมา",
      "start": 121.335
    },
    {
      "text": "เดลลากลับบ้านผมสั้นแค่ติ่งหู",
      "start": 123.523
    },
    {
      "text": "แต่ในมือเธอมีเงินยี่สิบดอลลาร์",
      "start": 126.719
    },
    {
      "text": "เธอใช้เวลาสองชั่วโมงเดินหาร้านแล้วหาร้านอีก",
      "start": 129.631
    },
    {
      "text": "เลือกของขวัญให้จิม",
      "start": 133.608
    },
    {
      "text": "และเธอก็พบมัน",
      "start": 135.852
    },
    {
      "text": "สายนาฬิกาแพลทินัม",
      "start": 138.04
    },
    {
      "text": "เรียบเงางามไม่มีลวดลายเกินจำเป็น",
      "start": 140.497
    },
    {
      "text": "คู่ควรกับนาฬิกาทองคำของจิม",
      "start": 143.935
    },
    {
      "text": "นาฬิกาเรือนนั้นเป็นมรดกจากพ่อของเขา",
      "start": 147.316
    },
    {
      "text": "เป็นสิ่งที่มีค่าที่สุดที่จิมมี",
      "start": 151.009
    },
    {
      "text": "เป็นสิ่งเดียวที่เขาไม่เคยยอมปล่อย",
      "start": 154.063
    },
    {
      "text": "เดลลาจ่ายเงินยี่สิบดอลลาร์",
      "start": 157.131
    },
    {
      "text": "แล้วรีบกลับบ้านด้วยความดีใจ",
      "start": 159.943
    },
    {
      "text": "ถึงบ้านเธอต้มน้ำกินข้าว",
      "start": 162.841
    },
    {
      "text": "แล้วนั่งรอจิมกลับมา",
      "start": 165.668
    },
    {
      "text": "หกโมงเย็นประตูเปิด",
      "start": 168.239
    },
    {
      "text": "จิมก้าวเข้ามาแล้วหยุดชะงัก",
      "start": 170.526
    },
    {
      "text": "เขาจ้องมองเดลลา",
      "start": 173.082
    },
    {
      "text": "สายตาของเขาแปลกไป",
      "start": 175.256
    },
    {
      "text": "ไม่ใช่โกรธไม่ใช่ผิดหวัง",
      "start": 177.798
    },
    {
      "text": "แต่เป็นสายตาของคนที่เพิ่งเห็นอะไรบางอย่าง",
      "start": 180.426
    },
    {
      "text": "เดลลาลุกขึ้นเดินไปหาเขา",
      "start": 183.992
    },
    {
      "text": "จิมอย่ามองฉันแบบนั้น",
      "start": 186.818
    },
    {
      "text": "ฉันตัดผมขายเพราะอยากได้ของขวัญให้เธอ",
      "start": 189.375
    },
    {
      "text": "ผมของฉันมันจะยาวใหม่ก็ได้ไม่เป็นไรนะ",
      "start": 192.969
    },
    {
      "text": "จิมไม่พูดอะไร",
      "start": 196.747
    },
    {
      "text": "เขาเดินเข้าไปกอดเธอแน่น",
      "start": 198.85
    },
    {
      "text": "กอดนานจนเดลลาเริ่มหายใจไม่ออก",
      "start": 201.335
    },
    {
      "text": "แล้วเขาก็วางห่อของลงบนโต๊ะ",
      "start": 204.489
    },
    {
      "text": "เดลลาแกะห่อนั้น",
      "start": 207.344
    },
    {
      "text": "มือของเธอสั่น",
      "start": 209.503
    },
    {
      "text": "ข้างในคือหวี",
      "start": 211.406
    },
    {
      "text": "หวีสองอันที่เธอเคยเห็นในร้าน",
      "start": 213.409
    },
    {
      "text": "หวีที่เธออยากได้มาตลอด",
      "start": 216.378
    },
    {
      "text": "หวีที่ทำมาเพื่อผมยาวของเธอโดยเฉพาะ",
      "start": 218.892
    },
    {
      "text": "หวีที่เธอฝันถึงทุกคืน",
      "start": 222.33
    },
    {
      "text": "เดลลาน้ำตาไหล",
      "start": 224.943
    },
    {
      "text": "แล้วเธอก็เงยหน้าขึ้นถาม",
      "start": 227.074
    },
    {
      "text": "จิมขายนาฬิกาไปแล้วใช่ไหม",
      "start": 229.787
    },
    {
      "text": "จิมยิ้มแล้วตอบเบาๆ",
      "start": 232.841
    },
    {
      "text": "ผมขายนาฬิกาไป",
      "start": 235.327
    },
    {
      "text": "เพื่อซื้อหวีให้เธอ",
      "start": 237.77
    },
    {
      "text": "เธอตัดผมขายเพื่อซื้อสายนาฬิกาให้ผม",
      "start": 239.915
    },
    {
      "text": "ทั้งคู่มองหน้ากัน",
      "start": 243.636
    },
    {
      "text": "แล้วก็หัวเราะออกมา",
      "start": 245.838
    },
    {
      "text": "ในห้องแคบๆแปดดอลลาร์ต่อสัปดาห์",
      "start": 248.225
    },
    {
      "text": "ของขวัญสองชิ้นนั้นใช้ไม่ได้จริง",
      "start": 251.591
    },
    {
      "text": "หวีกับผมที่ไม่มีแล้ว",
      "start": 254.759
    },
    {
      "text": "สายนาฬิกากับนาฬิกาที่ไม่มีแล้ว",
      "start": 257.244
    },
    {
      "text": "แต่นั่นแหละ",
      "start": 260.611
    },
    {
      "text": "ของขวัญที่ดีที่สุด",
      "start": 262.188
    },
    {
      "text": "ไม่ใช่สิ่งที่ซื้อด้วยเงิน",
      "start": 264.375
    },
    {
      "text": "แต่คือสิ่งที่เรายอมเสียสละเพื่อคนที่เรารัก",
      "start": 266.889
    },
    {
      "text": "หนึ่งดอลลาร์แปดสิบเจ็ดเซนต์",
      "start": 270.625
    },
    {
      "text": "กับหัวใจที่ให้จนหมด",
      "start": 273.352
    },
    {
      "text": "ของขวัญของคนสองคน",
      "start": 275.696
    },
    {
      "text": "ที่ยอมเป็นคนโง่เพื่อให้อีกคนได้ยิ้ม",
      "start": 278.296
    },
    {
      "text": "และนั่นแหละ",
      "start": 281.563
    },
    {
      "text": "คือของขวัญที่ฉลาดที่สุดในโลก",
      "start": 283.154
    },
    {
      "text": "ขอบคุณที่ฟังเรื่องราวของเดลลาและจิม",
      "start": 286.051
    },
    {
      "text": "ถ้าคุณมีใครสักคนที่รัก",
      "start": 289.332
    },
    {
      "text": "อย่าลืมบอกเขาว่าคุณรักเขา",
      "start": 292.003
    },
    {
      "text": "และถ้ายังไม่มี",
      "start": 294.929
    },
    {
      "text": "ขอให้วันหนึ่งคุณได้เจอ",
      "start": 297.06
    },
    {
      "text": "คนที่ยอมเป็นคนโง่เพื่อคุณเหมือนกัน",
      "start": 299.716
    }
  ]
}